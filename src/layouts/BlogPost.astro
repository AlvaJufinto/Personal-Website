---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import BaseHead from "@/components/ui/BaseHead.astro";
import Footer from "@/components/ui/Footer.astro";
import FormattedDate from "@/components/ui/FormattedDate.astro";
import Header from "@/components/ui/Header.astro";
import Tags from "@/components/ui/Tags.astro";
import getRecommendedPosts from "@/lib/BlogRecommender";
import BlogCard from "@/components/Blog/BlogCard.astro";
import { Image } from "astro:assets";

type Props = {
  post: CollectionEntry<"blog">;
};

const { post } = Astro.props;

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  topics = [],
  language,
} = post.data;

const allPosts = await getCollection("blog");

const relatedPosts = getRecommendedPosts(post, allPosts, 3);

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  image: heroImage
    ? typeof heroImage === "string"
      ? heroImage
      : // @ts-ignore
        heroImage.src
    : null,
  keywords: topics.join(", "),
  mainEntityOfPage: Astro.url.href,
};

const excerpt = post.body?.replace(/[#*_>`-]/g, "").slice(0, 160);

const wordCount =
  post.body
    ?.replace(/```[\s\S]*?```/g, "") // hapus code block
    .replace(/`.*?`/g, "") // hapus inline code
    .trim()
    .split(/\s+/).length || 0;

const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <BaseHead
      title={title}
      description={description ?? excerpt}
      image={heroImage}
      type="article"
      publishedTime={pubDate}
      modifiedTime={updatedDate}
      tags={topics}
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>

  <body>
    <Header />

    <main class="article-shell">
      {
        heroImage &&
          (typeof heroImage === "string" ? (
            <img class="article-image" src={heroImage} alt={title} />
          ) : (
            <Image class="article-image" src={heroImage} alt={title} />
          ))
      }

      <header>
        <p class="meta flex flex-wrap items-center gap-x-2">
          <FormattedDate date={pubDate} />

          {readingTime && <span>· {readingTime} min read</span>}
        </p>

        <h1 class="display-text mt-4">{title}</h1>

        {
          description && (
            <p class="mt-4 max-w-[58ch] text-[1.0625rem] leading-[1.75] text-secondary">
              {description}
            </p>
          )
        }

        <Tags topics={topics} language={language} />
      </header>

      <article class="markdown">
        <slot />
      </article>

      {
        relatedPosts.length > 0 && (
          <section class="mt-16 border-t border-line pt-8">
            <h2 class="section-title mb-2">Related Articles</h2>

            <div class="divide-y divide-line">
              {relatedPosts.map((post) => (
                <BlogCard post={post} />
              ))}
            </div>
          </section>
        )
      }
    </main>

    <Footer />
  </body>
</html>
