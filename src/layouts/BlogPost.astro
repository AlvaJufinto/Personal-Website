---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import BaseHead from "@/components/ui/BaseHead.astro";
import Footer from "@/components/ui/Footer.astro";
import FormattedDate from "@/components/ui/FormattedDate.astro";
import Header from "@/components/ui/Header.astro";
import Tags from "@/components/ui/Tags.astro";
import getRecommendedPosts from "@/lib/BlogRecommender";
import BlogCard from "@/components/Blog/BlogCard.astro";
import { Image } from "astro:assets";

type Props = {
  post: CollectionEntry<"blog">;
};

const { post } = Astro.props;

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  topics = [],
  language,
} = post.data;

const allPosts = await getCollection("blog");

const relatedPosts = getRecommendedPosts(post, allPosts, 3);

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  image: heroImage
    ? typeof heroImage === "string"
      ? heroImage
      : // @ts-ignore
        heroImage.src
    : null,
  keywords: topics.join(", "),
  mainEntityOfPage: Astro.url.href,
};

const excerpt = post.body?.replace(/[#*_>`-]/g, "").slice(0, 160);

const wordCount =
  post.body
    ?.replace(/```[\s\S]*?```/g, "") // hapus code block
    .replace(/`.*?`/g, "") // hapus inline code
    .trim()
    .split(/\s+/).length || 0;

const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description ?? excerpt}
      image={heroImage}
      type="article"
      publishedTime={pubDate}
      modifiedTime={updatedDate}
      tags={topics}
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>

  <body>
    <Header />

    <main class="custom-container">
      {
        heroImage &&
          (typeof heroImage === "string" ? (
            <img
              class="border border-slate-200 w-full h-auto"
              src={heroImage}
              alt={title}
            />
          ) : (
            <Image
              class="border border-slate-200 w-full h-auto"
              src={heroImage}
              alt={title}
            />
          ))
      }

      <div class="mt-4 prose prose-slate max-w-none">
        <div class="mb-8">
          <div class="mb-4">
            <p
              class="font-secondary text-slate-500 text-sm flex flex-wrap items-center gap-2"
            >
              <FormattedDate date={pubDate} />

              {readingTime && <span>• {readingTime} min read</span>}

              <!--{
                updatedDate && (
                  <span>
                    • Last updated on <FormattedDate date={updatedDate} />
                  </span>
                )
              }-->
            </p>
          </div>

          <h1
            class="font-primary text-3xl font-bold tracking-tight text-slate-900 md:text-4xl mb-4"
          >
            {title}
          </h1>

          {
            description && (
              <p class="font-secondary text-lg text-slate-600 leading-relaxed">
                {description}
              </p>
            )
          }

          <Tags topics={topics} language={language} />
        </div>

        <div class="markdown border-t border-slate-200 pt-8">
          <slot />
        </div>
      </div>
      {
        relatedPosts.length > 0 && (
          <section class="mt-16 border-t border-slate-200 pt-8">
            <h2 class="font-primary text-2xl font-bold mb-6">
              Related Articles
            </h2>

            <div class="grid gap-6 md:grid-cols-3">
              {relatedPosts.map((post) => (
                <BlogCard post={post} slug={post.id} />
              ))}
            </div>
          </section>
        )
      }
    </main>

    <Footer />
  </body>
</html>
