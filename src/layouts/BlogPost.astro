---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import BaseHead from "@/components/ui/BaseHead.astro";
import Footer from "@/components/ui/Footer.astro";
import FormattedDate from "@/components/ui/FormattedDate.astro";
import Header from "@/components/ui/Header.astro";
import MarginNote from "@/components/ui/MarginNote.astro";
import Tags from "@/components/ui/Tags.astro";
import getRecommendedPosts from "@/lib/BlogRecommender";
import BlogCard from "@/components/Blog/BlogCard.astro";
import { Image } from "astro:assets";

type Props = {
  post: CollectionEntry<"blog">;
};

const { post } = Astro.props;

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  topics = [],
  language,
} = post.data;

const allPosts = await getCollection("blog");

const relatedPosts = getRecommendedPosts(post, allPosts, 3);

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  image: heroImage
    ? typeof heroImage === "string"
      ? heroImage
      : // @ts-ignore
        heroImage.src
    : null,
  keywords: topics.join(", "),
  mainEntityOfPage: Astro.url.href,
};

const excerpt = post.body?.replace(/[#*_>`-]/g, "").slice(0, 160);

const wordCount =
  post.body
    ?.replace(/```[\s\S]*?```/g, "") // hapus code block
    .replace(/`.*?`/g, "") // hapus inline code
    .trim()
    .split(/\s+/).length || 0;

const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<!doctype html>
<html lang="en" data-theme="dark" data-proportion="golden">
  <head>
    <BaseHead
      title={title}
      description={description ?? excerpt}
      image={heroImage}
      type="article"
      publishedTime={pubDate}
      modifiedTime={updatedDate}
      tags={topics}
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>

  <body>
    <Header />

    <main
      id="main"
      class="mx-auto max-w-(--measure) px-6 pt-14 pb-25 max-[680px]:px-5 max-[680px]:pt-10 max-[680px]:pb-18"
    >
      {
        heroImage &&
          (typeof heroImage === "string" ? (
            <img
              class="mb-10 aspect-video w-full rounded-lg border border-line object-cover"
              src={heroImage}
              alt={title}
            />
          ) : (
            <Image
              class="mb-10 aspect-video w-full rounded-lg border border-line object-cover"
              src={heroImage}
              alt={title}
            />
          ))
      }

      <header class="mb-12">
        <p class="meta flex flex-wrap items-center gap-x-2">
          <FormattedDate date={pubDate} />

          {readingTime && <span>· {readingTime} min read</span>}
        </p>

        <MarginNote
          id="creative-note-1"
          side="left"
          lead="01 / That estimate"
          anchor="prev"
          arrowTop="2px"
        >
          The minutes are arithmetic, not a stopwatch: two hundred words a
          minute, and code blocks never counted.
        </MarginNote>

        <h1 class="display-text mt-4">{title}</h1>

        {
          description && (
            <p class="mt-4 max-w-[58ch] text-[1.0625rem] leading-[1.75] text-secondary">
              {description}
            </p>
          )
        }

        <Tags topics={topics} language={language} />
      </header>

      <article class="markdown">
        <slot />
      </article>

      {
        relatedPosts.length > 0 && (
          <section class="mt-16 border-t border-line pt-8">
            <h2 class="section-title mb-2">Related Articles</h2>

            <MarginNote
              id="creative-note-2"
              side="right"
              lead="02 / How these three were picked"
              anchor="prev"
              arrowTop="0px"
            >
              Not chosen by tag alone. A score sorts them: mostly what the
              writing means to an embedding model, a little topic overlap, a
              small nudge for anything recent.
            </MarginNote>

            <div class="divide-y divide-line">
              {relatedPosts.map((post) => (
                <BlogCard post={post} />
              ))}
            </div>
          </section>
        )
      }
    </main>

    <Footer />
  </body>
</html>
