---
import type { CollectionEntry } from "astro:content";

import BaseHead from "@/components/ui/BaseHead.astro";
import Footer from "@/components/ui/Footer.astro";
import FormattedDate from "@/components/ui/FormattedDate.astro";
import Header from "@/components/ui/Header.astro";
import MarginNote from "@/components/ui/MarginNote.astro";

import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

import { SITE_URL, AUTHOR_NAME } from "@/consts";

const linkStyles = {
  github: {
    icon: "mdi:github",
    label: "GitHub",
  },
  gitlab: {
    icon: "mdi:gitlab",
    label: "GitLab",
  },
  deployment: {
    icon: "mdi:rocket-launch",
    label: "Live",
  },
  website: {
    icon: "mdi:web",
    label: "Website",
  },
  figma: {
    icon: "mdi:figma",
    label: "Figma",
  },
  documentation: {
    icon: "mdi:file-document-outline",
    label: "Docs",
  },
  other: {
    icon: "mdi:open-in-new",
    label: "Link",
  },
};

type Props = CollectionEntry<"work">["data"];

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  logo,
  category = [],
  tech = [],
  links = [],
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark" data-proportion="golden">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage}
      type="website"
      publishedTime={pubDate}
      modifiedTime={updatedDate}
      tags={[...category, ...tech]}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "CreativeWork",
        name: title,
        description: description,
        datePublished: pubDate.toISOString(),
        dateModified: (updatedDate ?? pubDate).toISOString(),
        image: heroImage
          ? typeof heroImage === "string"
            ? heroImage
            : heroImage.src
          : null,
        keywords: [...category, ...tech].join(", "),
        url: Astro.url.href,
        author: {
          "@type": "Person",
          name: AUTHOR_NAME,
          url: SITE_URL,
        },
        programmingLanguage: tech,
        genre: category.join(", "),
      })}
    />
  </head>

  <body>
    <Header />

    <main id="main" class="measure py-14 md:py-20">
      {
        heroImage && (
          <div class="mb-12">
            <Image
              class="max-h-[420px] w-full rounded-lg border border-line object-cover"
              width={1200}
              src={heroImage}
              alt={title}
            />
          </div>
        )
      }

      <article>
        <header class="flex items-start gap-5">
          {
            logo && (
              <div class="mt-1 h-12 w-12 shrink-0 overflow-hidden rounded-lg border border-line bg-surface p-2">
                <Image
                  src={logo}
                  alt={`${title} logo`}
                  width={48}
                  height={48}
                  class="h-full w-full object-contain"
                />
              </div>
            )
          }

          <div class="min-w-0 flex-1">
            <p class="meta flex flex-wrap items-center gap-x-2">
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <span>
                    · updated <FormattedDate date={updatedDate} />
                  </span>
                )
              }
            </p>

            <h1 class="display-text mt-3">{title}</h1>

            {
              description && (
                <p class="mt-4 max-w-[58ch] text-[1.0625rem] leading-[1.75] text-secondary">
                  {description}
                </p>
              )
            }
          </div>
        </header>

        {
          (category.length > 0 || tech.length > 0 || links.length > 0) && (
            <dl class="mt-9 grid gap-x-8 gap-y-6 border-y border-line py-6 sm:grid-cols-2">
              {category.length > 0 && (
                <div>
                  <dt class="label">Topics</dt>
                  <dd class="mt-2 flex flex-wrap gap-1.5">
                    {category.map((item) => (
                      <span class="pill">{item}</span>
                    ))}
                  </dd>
                </div>
              )}

              {tech.length > 0 && (
                <div>
                  <dt class="label">Stack</dt>
                  <dd class="mt-2 flex flex-wrap gap-1.5">
                    {tech.map((item) => (
                      <span class="pill">{item}</span>
                    ))}
                  </dd>
                </div>
              )}

              {links.length > 0 && (
                <div class="sm:col-span-2">
                  <dt class="label">Links</dt>
                  <dd class="mt-2 flex flex-wrap gap-x-5 gap-y-2">
                    {links.map((link) => {
                      const style = linkStyles[link.type] ?? linkStyles.other;
                      return (
                        <a
                          href={link.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1.5 text-sm text-ink underline decoration-line-strong underline-offset-4 hover:decoration-accent"
                        >
                          <Icon
                            name={style.icon}
                            class="h-3.5 w-3.5 shrink-0"
                          />
                          {link.label || style.label}
                        </a>
                      );
                    })}
                  </dd>
                </div>
              )}
            </dl>
          )
        }

        <MarginNote
          id="creative-note-1"
          side="right"
          lead="01 / The spec sheet"
          anchor="prev"
          arrowTop="26px"
        >
          The stuff I look for on other people's pages.
        </MarginNote>

        <section class="markdown mt-10">
          <slot />
        </section>
      </article>
    </main>

    <Footer />
  </body>
</html>
