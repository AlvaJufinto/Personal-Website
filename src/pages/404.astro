---
import BaseHead from "@/components/ui/BaseHead.astro";
import Header from "@/components/ui/Header.astro";
import Footer from "@/components/ui/Footer.astro";
import MarginNote from "@/components/ui/MarginNote.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "@/consts";
---

<!doctype html>
<html lang="en" data-theme="dark" data-proportion="golden">
  <head>
    <BaseHead title="404 — Page Not Found" description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <main id="main" class="measure py-20 md:py-28">
      <p class="meta">Error 404</p>

      <h1 class="display-text mt-3">Page not found.</h1>

      <p class="mt-5 max-w-[52ch] leading-[1.8] text-secondary">
        The page you're looking for doesn't exist or has been moved.
      </p>

      <a
        href="/"
        class="mt-8 inline-flex items-center gap-2 border-b border-line-strong pb-1 text-sm text-ink hover:decoration-line-strong hover:underline-offset-4"
      >
        <span aria-hidden="true">←</span> Back to home
      </a>

      <MarginNote
        id="creative-note-1"
        side="right"
        lead="01 / On a better route"
        anchor="prev"
        arrowTop="2px"
      >
        Whatever linked you here pointed at something I moved. That one's on me;
        the rest of the site is still where you expected it.
      </MarginNote>
    </main>

    <Footer />
  </body>
</html>
