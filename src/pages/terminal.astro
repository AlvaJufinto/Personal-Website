---
import { getCollection } from "astro:content";
import BaseHead from "../components/ui/BaseHead.astro";

import {
  SITE_TITLE,
  SITE_URL,
  PROFILE,
  SOCIALS,
  CONTACT,
  SITE_SECTIONS,
} from "@/consts";

const workCollection = await getCollection("work");
const blogCollection = await getCollection("blog");

const work = workCollection
  .filter((item) => !item.data.isDraft)
  .map((item) => ({
    // @ts-ignore
    slug: item.slug,
    title: item.data.title,
    description: item.data.description,
    pubDate: item.data.pubDate
      ? new Date(item.data.pubDate).toISOString()
      : undefined,
  }));

const blog = blogCollection
  .filter((item) => !item.data.isDraft)
  .map((item) => ({
    // @ts-ignore
    slug: item.slug,
    title: item.data.title,
    description: item.data.description,
    pubDate: item.data.pubDate
      ? new Date(item.data.pubDate).toISOString()
      : undefined,
  }))
  .sort((a, b) => {
    if (!a.pubDate || !b.pubDate) {
      return 0;
    }

    return new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime();
  });

const terminalData = {
  siteTitle: SITE_TITLE,
  siteUrl: SITE_URL,
  profile: PROFILE,
  socials: SOCIALS,
  contact: CONTACT,
  sections: SITE_SECTIONS,
  work,
  blog,
};

const serializedData = JSON.stringify(terminalData);
---

<html lang="en">
  <head>
    <BaseHead
      title={`Terminal — ${SITE_TITLE}`}
      description={`Terminal interface for ${SITE_TITLE}`}
    />
  </head>

  <body>
    <main class="terminal-page">
      <div
        id="terminal-output"
        class="terminal-output"
        aria-live="polite"
        aria-label="Terminal output"
      >
      </div>

      <div class="terminal-input-row">
        <span class="terminal-prompt" aria-hidden="true"> alva@web:~$ </span>

        <input
          id="terminal-input"
          class="terminal-input"
          type="text"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          aria-label="Terminal command"
        />
      </div>
    </main>

    <script define:vars={{ serializedData }}>
      window.__TERMINAL_DATA__ = serializedData;
    </script>

    <script>
      import { initTerminal } from "@/lib/terminal-commands";

      // @ts-ignore
      const serializedData = window.__TERMINAL_DATA__ ?? "{}";

      const data = JSON.parse(serializedData);

      initTerminal(data);
    </script>
  </body>
</html>

<style>
  :global(html) {
    width: 100%;
    height: 100%;
    background: #000;
  }

  :global(body) {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: #000;
    color: #f5f5f5;
  }

  :global(*) {
    box-sizing: border-box;
  }

  .terminal-page {
    width: 100%;
    height: 100dvh;
    min-height: 100vh;

    display: flex;
    flex-direction: column;

    padding: 18px 40px;

    background: #000;
    color: #f5f5f5;

    font-family:
      "JetBrains Mono", "SFMono-Regular", "Cascadia Code", "Roboto Mono",
      Consolas, "Liberation Mono", monospace;

    font-size: 13px;
    line-height: 1.2;
    letter-spacing: 0.2px;
  }

  .terminal-output {
    flex: 1;
    min-height: 0;

    padding: 0 8px;

    overflow-x: hidden;
    overflow-y: auto;

    scrollbar-width: thin;
    scrollbar-color: #333 transparent;
  }

  .terminal-output::-webkit-scrollbar {
    width: 6px;
  }

  .terminal-output::-webkit-scrollbar-track {
    background: transparent;
  }

  .terminal-output::-webkit-scrollbar-thumb {
    background: #333;
  }

  :global(.terminal-line) {
    min-height: 0;

    margin: 0;
    padding: 0;

    line-height: 1.5;

    white-space: pre-wrap;
    word-break: break-word;
  }

  :global(.terminal-line + .terminal-line) {
    margin-top: 5px;
  }

  :global(.terminal-line.heading) {
    margin-top: 14px;
    margin-bottom: 4px;

    font-weight: 700;
  }

  :global(.terminal-line.dim) {
    color: #666;
  }

  :global(.terminal-line.error) {
    color: #aaa;
  }

  :global(.terminal-line.input) {
    color: #f5f5f5;
  }

  :global(.terminal-line.link) {
    cursor: pointer;
  }

  :global(.terminal-link) {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  :global(.terminal-link:hover) {
    color: #fff;
  }

  :global(.terminal-list) {
    display: grid;

    grid-template-columns: 3ch minmax(0, 1fr);

    column-gap: 28px;
    row-gap: 2px;

    width: 100%;
  }

  :global(.terminal-list-index) {
    color: #555;
    user-select: none;
    text-align: right;
  }

  :global(.terminal-list-content) {
    min-width: 0;
  }

  .terminal-input-row {
    display: flex;
    flex-shrink: 0;
    align-items: baseline;

    gap: 9px;

    margin-top: 8px;
    padding-top: 7px;

    border-top: 1px solid #151515;
  }

  .terminal-prompt {
    flex-shrink: 0;

    color: #f5f5f5;
    user-select: none;
  }

  .terminal-input {
    width: 100%;
    min-width: 0;

    margin: 0;
    padding: 0;

    border: 0;
    outline: 0;

    background: transparent;
    color: #f5f5f5;

    font: inherit;
    line-height: 1.2;

    caret-color: #fff;
  }

  .terminal-input::selection {
    background: #444;
  }

  @media (max-width: 640px) {
    .terminal-page {
      padding: 14px 18px;
      font-size: 12px;
    }

    .terminal-output {
      padding: 0 4px;
    }

    .terminal-input-row {
      gap: 7px;
    }

    :global(.terminal-list) {
      column-gap: 18px;
    }
  }
</style>
