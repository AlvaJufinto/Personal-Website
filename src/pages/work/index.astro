---
import { getCollection } from "astro:content";
import BaseHead from "@/components/ui/BaseHead.astro";
import Footer from "@/components/ui/Footer.astro";
import Header from "@/components/ui/Header.astro";
import WorkCard from "@/components/Work/WorkCard.astro";
import TechStack from "@/components/Work/TechStack.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "@/consts";

const works = (await getCollection("work"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .filter((post) => !post.data.isDraft);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <BaseHead title={`${SITE_TITLE} | Work`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <main class="shell py-14 md:py-20">
      <section>
        <h1 class="display-text">Work</h1>

        <p class="mt-4 max-w-[60ch] text-secondary">
          My past projects and experiences.
        </p>

        {
          works.length > 0 ? (
            <div class="mt-10 divide-y divide-line border-y border-line">
              {works.map((work) => (
                <WorkCard work={work} slug={work.id} />
              ))}
            </div>
          ) : (
            <p class="meta mt-8">No projects yet.</p>
          )
        }
      </section>

      <section class="mt-20">
        <h2 class="section-title">Skills</h2>

        <p class="mt-4 max-w-[60ch] text-secondary">Tools I work with.</p>

        <div class="mt-8 border-t border-line pt-8">
          <TechStack />
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
