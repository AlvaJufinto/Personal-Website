---
import { getCollection } from "astro:content";
import BaseHead from "@/components/ui/BaseHead.astro";
import ColumnMeasure from "@/components/ui/ColumnMeasure.astro";
import Footer from "@/components/ui/Footer.astro";
import Header from "@/components/ui/Header.astro";
import MarginNote from "@/components/ui/MarginNote.astro";
import WorkCard from "@/components/Work/WorkCard.astro";
import TechStack from "@/components/Work/TechStack.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "@/consts";

const works = (await getCollection("work"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .filter((post) => !post.data.isDraft);
---

<!doctype html>
<html lang="en" data-theme="dark" data-proportion="golden">
  <head>
    <BaseHead title={`${SITE_TITLE} | Work`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <main id="main" class="folio">
      <ColumnMeasure />

      <section class="section">
        <h1 class="display-text">Work</h1>

        <p class="body-copy mt-5">My past projects and experiences.</p>

        {
          works.length > 0 ? (
            <div class="mt-5 divide-y divide-line border-t border-line">
              {works.map((work) => (
                <WorkCard work={work} slug={work.id} />
              ))}
            </div>
          ) : (
            <p class="meta mt-8">No projects yet.</p>
          )
        }

        <MarginNote
          id="creative-note-1"
          side="left"
          lead="01 / Selected work"
          anchor="prev"
          arrowTop="46px"
        >
          Every row links through to its own project page.
        </MarginNote>
      </section>

      <section class="section">
        <h2 class="section-title">Skills</h2>

        <p class="body-copy mt-5">Tools I work with.</p>

        <div class="mt-5">
          <TechStack />
        </div>

        <MarginNote
          id="creative-note-2"
          side="left"
          lead="02 / Sorted by the job"
          anchor="prev"
          arrowTop="30px"
        >
          Grouped by where the work happened rather than by preference, which is
          the honest way a stack like this grows.
        </MarginNote>
      </section>
    </main>

    <Footer />
  </body>
</html>
