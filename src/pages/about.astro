---
import { SITE_DESCRIPTION, SITE_TITLE, SOCIALS } from "@/consts";
import BaseHead from "@/components/ui/BaseHead.astro";
import Header from "@/components/ui/Header.astro";
import Footer from "@/components/ui/Footer.astro";
import { Icon } from "astro-icon/components";

const achievements = [
  {
    year: "2026",
    title: "1st Place — Garuda Hacks 7.0",
    subtitle: "Agriculture & Food Systems",
    description:
      "Won the Agriculture & Food Systems track with Harvey, a decision-support system for irrigation managers. The project helps prioritize water distribution and make better use of limited water resources.",
  },
  {
    year: "2026",
    title: "3rd Place — TechSprint Innovation Cup",
    subtitle: "Business Plan Competition",
    description:
      "Presented SAJAK (SahabatPajak), a technology and business concept that uses automation to make tax administration more accessible.",
  },
  {
    year: "2025",
    title: "4th Place — GEMASTIK XVIII 2025",
    subtitle: "Software Development",
    description:
      "Represented BINUS University at the national finals with TemanNelayan. The project combines software engineering and marine data analysis to help small-scale fishermen identify safer fishing zones.",
  },
  {
    year: "2025",
    title: "Top 5 — Pertamuda Seed & Scale by Pertamina",
    subtitle: "Energy Optimization",
    description:
      "Recognized by Pertamina and Danantara Indonesia for HydroSmart, an IoT-based system designed to optimize water use in AI data centers.",
  },
];
---

<html lang="en">
  <head>
    <BaseHead title={`${SITE_TITLE} | About`} description={SITE_DESCRIPTION} />
  </head>

  <body>
    <Header />

    <main class="custom-container">
      <section class="prose prose-slate max-w-none">
        <!-- Hero -->
        <div class="mb-12">
          <div
            class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between"
          >
            <div class="max-w-3xl">
              <h1
                class="font-primary text-3xl font-bold tracking-tight text-slate-900"
              >
                A little about me.
              </h1>

              <p
                class="font-secondary mt-4 text-base leading-relaxed text-slate-600"
              >
                I build software to solve problems, explore ideas, and make
                things that are useful beyond the screen.
              </p>
            </div>
          </div>
        </div>

        <hr class="line" />

        <div class="pt-12">
          <!-- About -->
          <section class="mb-20">
            <h2 class="font-primary mb-6 text-3xl font-semibold text-slate-900">
              About me.
            </h2>

            <div class="max-w-3xl space-y-5">
              <p class="font-secondary leading-relaxed text-slate-700">
                I'm a Computer Science student and software engineer. I've spent
                the past few years building web applications, working with
                different teams, and turning ideas into working software.
              </p>

              <p class="font-secondary leading-relaxed text-slate-700">
                My work has ranged from business applications and internal tools
                to projects involving machine learning, data, and hardware. I
                enjoy working across the stack, but I'm just as interested in
                understanding the problem, the people dealing with it, and
                whether the solution actually makes a difference.
              </p>

              <p class="font-secondary leading-relaxed text-slate-700">
                I don't have a single area I want to stay in. Software
                engineering is where I started, but I'm interested in the
                different ways technology can be applied, especially when a
                problem requires more than writing code.
              </p>
            </div>
          </section>

          <!-- How I Build -->
          <section class="mb-20">
            <h2 class="font-primary mb-6 text-3xl font-semibold text-slate-900">
              How I work.
            </h2>

            <div class="max-w-3xl space-y-5">
              <p class="font-secondary leading-relaxed text-slate-700">
                I tend to learn by building. Working on a project forces me to
                deal with things that rarely show up in tutorials: unclear
                requirements, unexpected edge cases, technical trade-offs, and
                the gap between something that works and something people can
                rely on.
              </p>

              <p class="font-secondary leading-relaxed text-slate-700">
                I usually start by understanding what needs to be solved. From
                there, I work through the implementation, test the result, and
                adjust when something doesn't work as expected. I care about the
                details, but I try not to lose sight of why the thing is being
                built in the first place.
              </p>

              <p class="font-secondary leading-relaxed text-slate-700">
                There's still a lot I haven't learned, and I don't see that as a
                problem. Each project gives me a reason to go a little further
                than I did with the last one.
              </p>
            </div>
          </section>

          <!-- Selected Recognition -->
          <section class="mb-20">
            <div class="mb-8 flex items-baseline justify-between gap-4">
              <h2 class="font-primary text-3xl font-semibold text-slate-900">
                Selected recognition.
              </h2>

              <span class="font-secondary text-sm text-slate-500">
                2025–2026
              </span>
            </div>

            <div class="space-y-0 border-t border-slate-200">
              {
                achievements.map((achievement) => (
                  <article class="grid gap-4 border-b border-slate-200 py-7 md:grid-cols-[80px_1fr]">
                    <span class="font-secondary text-sm font-medium text-slate-500">
                      {achievement.year}
                    </span>

                    <div>
                      <h3 class="font-primary text-xl font-semibold text-slate-900">
                        {achievement.title}
                      </h3>

                      <p class="font-secondary mt-1 text-sm font-semibold text-slate-600">
                        {achievement.subtitle}
                      </p>

                      <p class="font-secondary mt-3 max-w-3xl leading-relaxed text-slate-700">
                        {achievement.description}
                      </p>
                    </div>
                  </article>
                ))
              }
            </div>
          </section>

          <!-- Writing -->
          <section class="mb-20">
            <h2 class="font-primary mb-6 text-3xl font-semibold text-slate-900">
              What I write about.
            </h2>

            <p
              class="font-secondary mb-8 max-w-3xl leading-relaxed text-slate-700"
            >
              I also use this space to write things down. Some are technical
              notes, others are personal reflections. It's a place for ideas
              that don't necessarily belong in a project README.
            </p>

            <div class="grid gap-6 md:grid-cols-3">
              <article class="border border-slate-200 bg-slate-50 p-6">
                <h3
                  class="font-primary mb-3 text-xl font-semibold text-slate-900"
                >
                  Technology
                </h3>

                <p class="font-secondary leading-relaxed text-slate-700">
                  Notes on software development, AI, and the tools and ideas I'm
                  exploring. Sometimes technical, sometimes just an observation
                  worth writing down.
                </p>
              </article>

              <article class="border border-slate-200 bg-slate-50 p-6">
                <h3
                  class="font-primary mb-3 text-xl font-semibold text-slate-900"
                >
                  Life
                </h3>

                <p class="font-secondary leading-relaxed text-slate-700">
                  Experiences, personal reflections, and questions I've been
                  thinking about. Not everything needs to have a technical
                  explanation.
                </p>
              </article>

              <article class="border border-slate-200 bg-slate-50 p-6">
                <h3
                  class="font-primary mb-3 text-xl font-semibold text-slate-900"
                >
                  Faith
                </h3>

                <p class="font-secondary leading-relaxed text-slate-700">
                  Writing about Catholic faith, liturgy, and doctrine, along
                  with the questions that come with trying to put belief into
                  practice.
                </p>
              </article>
            </div>
          </section>

          <!-- Beyond Building -->
          <section class="mb-20">
            <h2 class="font-primary mb-6 text-3xl font-semibold text-slate-900">
              Outside of work.
            </h2>

            <div class="max-w-3xl space-y-5">
              <p class="font-secondary leading-relaxed text-slate-700">
                Away from a keyboard, I spend much of my time around music. I'm
                a pianist and organist, and I've been involved in playing music
                for Catholic liturgy for several years.
              </p>

              <p class="font-secondary leading-relaxed text-slate-700">
                My Catholic faith is also a significant part of my life. It
                shapes some of the things I read, the questions I ask, and
                occasionally what I write about here.
              </p>
            </div>
          </section>

          <!-- Language -->
          <section class="mb-16 border-l-4 border-slate-400 bg-slate-50 p-5">
            <p class="font-secondary text-sm leading-relaxed text-slate-700">
              <span class="font-semibold text-slate-900"
                >About the writing:</span
              >
              I write in both English and Indonesian, depending on the subject and
              which language lets me express the idea more naturally.
            </p>
          </section>

          <!-- Connect -->
          <section class="border-t border-slate-200 pt-10">
            <h2 class="font-primary mb-6 text-2xl font-semibold text-slate-900">
              Let's connect.
            </h2>

            <div class="flex flex-wrap gap-3">
              {
                SOCIALS.map((social) => (
                  <a
                    href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-secondary inline-flex items-center justify-center gap-2 border-2 border-slate-400 px-4 py-2 font-semibold text-slate-900 transition-colors hover:bg-slate-100"
                  >
                    <Icon name={social.icon} class="h-4 w-4" />
                    {social.label}
                  </a>
                ))
              }
            </div>
          </section>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
