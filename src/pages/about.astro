---
import { SITE_DESCRIPTION, SITE_TITLE, SOCIALS } from "@/consts";
import BaseHead from "@/components/ui/BaseHead.astro";
import ColumnMeasure from "@/components/ui/ColumnMeasure.astro";
import Header from "@/components/ui/Header.astro";
import Footer from "@/components/ui/Footer.astro";
import MarginNote from "@/components/ui/MarginNote.astro";
import { Icon } from "astro-icon/components";

const achievements = [
  {
    year: "2026",
    title: "1st Place — Garuda Hacks 7.0",
    subtitle: "Agriculture & Food Systems",
    description:
      "Built Harvey, a decision-support system for irrigation managers. It helps prioritize water distribution when water resources are limited.",
  },
  {
    year: "2026",
    title: "3rd Place — TechSprint Innovation Cup",
    subtitle: "Business Plan Competition",
    description:
      "Presented SAJAK (SahabatPajak), a technology and business concept focused on making tax administration more accessible through automation.",
  },
  {
    year: "2025",
    title: "4th Place — GEMASTIK XVIII 2025",
    subtitle: "Software Development",
    description:
      "Represented BINUS University at the national finals with TemanNelayan, a project combining software engineering and marine data analysis to help small-scale fishermen identify safer fishing zones.",
  },
  {
    year: "2025",
    title: "Top 5 — Pertamuda Seed & Scale by Pertamina",
    subtitle: "Energy Optimization",
    description:
      "Recognized by Pertamina and Danantara Indonesia for HydroSmart, an IoT-based system designed to optimize water use in AI data centers.",
  },
];
---

<!doctype html>
<html lang="en" data-theme="dark" data-proportion="golden">
  <head>
    <BaseHead title={`${SITE_TITLE} | About`} description={SITE_DESCRIPTION} />
  </head>

  <body>
    <Header />

    <main id="main" class="folio">
      <ColumnMeasure />

      <section class="section">
        <h1 class="display-text">A little about me.</h1>

        <p class="body-copy mt-5">
          I build software, experiment with ideas, and occasionally get carried
          away with figuring out how things work.
        </p>

        <MarginNote
          id="creative-note-1"
          side="right"
          lead="01 / The short version"
          anchor="prev"
          arrowTop="8px"
        >
          That's pretty much it.
        </MarginNote>
      </section>

      <!-- About -->
      <section class="section">
        <h2 class="section-title">About me.</h2>

        <div class="body-copy mt-5 space-y-4">
          <p>
            I'm a Computer Science student and software engineer. Over the past
            few years, I've worked on web applications, internal tools, and
            projects that go beyond the usual web stack.
          </p>

          <p>
            Some of that work has involved machine learning, data, and hardware.
            I enjoy working across the stack, but I'm also interested in
            understanding the problem itself: who's dealing with it, what they
            actually need, and whether what I build helps.
          </p>

          <p>
            I haven't settled on one particular field, and I'm not in a hurry
            to. Software engineering is where I started, but I'm curious about
            the different ways technology can be used to solve problems.
          </p>
        </div>

        <MarginNote
          id="creative-note-2"
          side="left"
          lead="02 / Still exploring"
          anchor="prev"
          arrowTop="10px"
        >
          Haven't picked just one lane.
        </MarginNote>
      </section>

      <!-- How I Build -->
      <section class="section">
        <h2 class="section-title">How I work.</h2>

        <div class="body-copy mt-5 space-y-4">
          <p>
            I usually learn by building. A project tends to teach me things
            tutorials don't: vague requirements, unexpected edge cases,
            technical trade-offs, and all the little things that come up once
            someone actually has to use the software.
          </p>

          <p>
            Before I start coding, I try to understand what needs fixing. Then I
            build, test, and adjust things as I go. I care about the
            implementation, but there's not much point polishing something that
            doesn't solve the right problem.
          </p>

          <p>
            There's still plenty I don't know. That's part of why I keep
            building things. There's always something else to figure out.
          </p>
        </div>

        <MarginNote
          id="creative-note-3"
          side="left"
          lead="03 / Real projects"
          anchor="prev"
          arrowTop="44px"
        >
          Tutorials don't cover everything.
        </MarginNote>
      </section>

      <!-- Selected Recognition -->
      <section class="section">
        <div class="section-heading has-subtitle">
          <h2 class="section-title section-heading-copy">
            Selected recognition.
          </h2>

          <span class="section-aside meta">2025–2026</span>
        </div>

        <div class="mt-5 divide-y divide-line border-t border-line">
          {
            achievements.map((achievement) => (
              <article class="grid gap-(--gold-space-1) py-(--gold-space-4) min-[680px]:grid-cols-[118px_minmax(0,1fr)] min-[680px]:items-baseline min-[680px]:gap-x-(--gold-space-4)">
                <p class="meta">{achievement.year}</p>

                <div class="min-w-0">
                  <h3 class="work-title">{achievement.title}</h3>

                  <p class="meta mt-1">{achievement.subtitle}</p>

                  <p class="work-description mt-2.5">
                    {achievement.description}
                  </p>
                </div>
              </article>
            ))
          }
        </div>

        <MarginNote
          id="creative-note-4"
          side="right"
          lead="04 / A few competitions"
          anchor="prev"
          arrowTop="26px"
        >
          Four competitions, four different problems.
        </MarginNote>
      </section>

      <!-- Writing -->
      <section class="section">
        <h2 class="section-title">What I write about.</h2>

        <p class="body-copy mt-5">
          I use this space to write things down. Some posts are technical,
          others are more personal. Mostly, it's a place for things I don't want
          to forget or that don't quite fit in a project README.
        </p>

        <div class="mt-5 divide-y divide-line border-t border-line">
          <article class="py-(--gold-space-4)">
            <h3 class="work-title">Technology</h3>

            <p class="work-description mt-1.5 max-w-[62ch]">
              Things I'm learning or trying out, from software development to
              AI. Sometimes it's a technical note; sometimes it's just something
              I found interesting.
            </p>
          </article>

          <article class="py-(--gold-space-4)">
            <h3 class="work-title">Life</h3>

            <p class="work-description mt-1.5 max-w-[62ch]">
              Things I've experienced, random thoughts, and questions I haven't
              quite figured out yet.
            </p>
          </article>

          <article class="py-(--gold-space-4)">
            <h3 class="work-title">Faith</h3>

            <p class="work-description mt-1.5 max-w-[62ch]">
              Notes on Catholic faith, liturgy, and doctrine. Usually, it's me
              trying to make sense of something or put a thought into words.
            </p>
          </article>
        </div>
      </section>

      <!-- Beyond Building -->
      <section class="section">
        <h2 class="section-title">Outside of work.</h2>

        <div class="body-copy mt-5 space-y-4">
          <p>
            When I'm away from my desk, I'm usually around music. I play piano
            and organ, and have spent the past few years playing for Catholic
            liturgies.
          </p>

          <p>
            My Catholic faith is a big part of my life, too. It influences what
            I read, the questions I ask, and some of the things I write about
            here.
          </p>
        </div>

        <MarginNote
          id="creative-note-5"
          side="left"
          lead="05 / The other keyboard"
          anchor="prev"
          arrowTop="14px"
        >
          Not all keyboards are mechanical.
        </MarginNote>
      </section>

      <!-- Language -->
      <aside
        class="section note-aside border-l border-line-strong pl-(--gold-space-4)"
      >
        <p class="work-description mt-5">
          <span class="text-ink">A note on language:</span>
          I write in both English and Indonesian. It mostly depends on the subject
          and which language feels right.
        </p>
      </aside>

      <!-- Connect -->
      <section class="section">
        <h2 class="section-title">Let's connect.</h2>

        <ul class="socials mt-5 flex flex-wrap gap-x-6 gap-y-2">
          {
            SOCIALS.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="quiet-link inline-flex items-center gap-1.5"
                >
                  <Icon name={social.icon} class="h-3.5 w-3.5 shrink-0" />
                  {social.label}
                </a>
              </li>
            ))
          }
        </ul>

        <MarginNote
          id="creative-note-6"
          side="right"
          lead="06 / Around the web"
          anchor="prev"
          arrowTop="6px"
        >
          I'm around here, too.
        </MarginNote>
      </section>
    </main>

    <Footer />
  </body>
</html>
