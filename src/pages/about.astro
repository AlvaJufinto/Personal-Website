---
import { SITE_DESCRIPTION, SITE_TITLE, SOCIALS } from "@/consts";
import BaseHead from "@/components/ui/BaseHead.astro";
import ColumnMeasure from "@/components/ui/ColumnMeasure.astro";
import Header from "@/components/ui/Header.astro";
import Footer from "@/components/ui/Footer.astro";
import MarginNote from "@/components/ui/MarginNote.astro";
import { Icon } from "astro-icon/components";

const achievements = [
  {
    year: "2026",
    title: "1st Place — Garuda Hacks 7.0",
    subtitle: "Agriculture & Food Systems",
    description:
      "Won the Agriculture & Food Systems track with Harvey, a decision-support system for irrigation managers. The project helps prioritize water distribution and make better use of limited water resources.",
  },
  {
    year: "2026",
    title: "3rd Place — TechSprint Innovation Cup",
    subtitle: "Business Plan Competition",
    description:
      "Presented SAJAK (SahabatPajak), a technology and business concept that uses automation to make tax administration more accessible.",
  },
  {
    year: "2025",
    title: "4th Place — GEMASTIK XVIII 2025",
    subtitle: "Software Development",
    description:
      "Represented BINUS University at the national finals with TemanNelayan. The project combines software engineering and marine data analysis to help small-scale fishermen identify safer fishing zones.",
  },
  {
    year: "2025",
    title: "Top 5 — Pertamuda Seed & Scale by Pertamina",
    subtitle: "Energy Optimization",
    description:
      "Recognized by Pertamina and Danantara Indonesia for HydroSmart, an IoT-based system designed to optimize water use in AI data centers.",
  },
];
---

<!doctype html>
<html lang="en" data-theme="dark" data-proportion="golden">
  <head>
    <BaseHead title={`${SITE_TITLE} | About`} description={SITE_DESCRIPTION} />
  </head>

  <body>
    <Header />

    <main id="main" class="folio">
      <ColumnMeasure />

      <section class="section">
        <h1 class="display-text">A little about me.</h1>

        <p class="body-copy mt-5">
          I build software to solve problems, explore ideas, and make things
          that are useful beyond the screen.
        </p>

        <MarginNote
          id="creative-note-1"
          side="right"
          lead="01 / The short version"
          anchor="prev"
          arrowTop="8px"
        >
          "Beyond the screen" is doing most of the work in that sentence. It's
          the part that decides whether something is worth finishing.
        </MarginNote>
      </section>

      <!-- About -->
      <section class="section">
        <h2 class="section-title">About me.</h2>

        <div class="body-copy mt-5 space-y-4">
          <p>
            I'm a Computer Science student and software engineer. I've spent the
            past few years building web applications, working with different
            teams, and turning ideas into working software.
          </p>

          <p>
            My work has ranged from business applications and internal tools to
            projects involving machine learning, data, and hardware. I enjoy
            working across the stack, but I'm just as interested in
            understanding the problem, the people dealing with it, and whether
            the solution actually makes a difference.
          </p>

          <p>
            I don't have a single area I want to stay in. Software engineering
            is where I started, but I'm interested in the different ways
            technology can be applied, especially when a problem requires more
            than writing code.
          </p>
        </div>
      </section>

      <!-- How I Build -->
      <section class="section">
        <h2 class="section-title">How I work.</h2>

        <div class="body-copy mt-5 space-y-4">
          <p>
            I tend to learn by building. Working on a project forces me to deal
            with things that rarely show up in tutorials: unclear requirements,
            unexpected edge cases, technical trade-offs, and the gap between
            something that works and something people can rely on.
          </p>

          <p>
            I usually start by understanding what needs to be solved. From
            there, I work through the implementation, test the result, and
            adjust when something doesn't work as expected. I care about the
            details, but I try not to lose sight of why the thing is being built
            in the first place.
          </p>

          <p>
            There's still a lot I haven't learned, and I don't see that as a
            problem. Each project gives me a reason to go a little further than
            I did with the last one.
          </p>
        </div>

        <MarginNote
          id="creative-note-2"
          side="left"
          lead="02 / What tutorials leave out"
          anchor="prev"
          arrowTop="44px"
        >
          Nobody warns you about the gap between something that works and
          something someone relies on. That gap is most of the job.
        </MarginNote>
      </section>

      <!-- Selected Recognition -->
      <section class="section">
        <div class="section-heading has-subtitle">
          <h2 class="section-title section-heading-copy">
            Selected recognition.
          </h2>

          <span class="section-aside meta">2025–2026</span>
        </div>

        <div class="mt-5 divide-y divide-line border-t border-line">
          {
            achievements.map((achievement) => (
              <article class="grid gap-(--gold-space-1) py-(--gold-space-4) min-[680px]:grid-cols-[118px_minmax(0,1fr)] min-[680px]:items-baseline min-[680px]:gap-x-(--gold-space-4)">
                <p class="meta">{achievement.year}</p>

                <div class="min-w-0">
                  <h3 class="work-title">{achievement.title}</h3>

                  <p class="meta mt-1">{achievement.subtitle}</p>

                  <p class="work-description mt-2.5">
                    {achievement.description}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
        <MarginNote
          id="creative-note-3"
          side="right"
          lead="03 / Two competition seasons"
          anchor="prev"
          arrowTop="26px"
        >
          Four entries across two years. A competition is a strange way to spend
          a semester, and all four were worth it.
        </MarginNote>
      </section>

      <!-- Writing -->
      <section class="section">
        <h2 class="section-title">What I write about.</h2>

        <p class="body-copy mt-5">
          I also use this space to write things down. Some are technical notes,
          others are personal reflections. It's a place for ideas that don't
          necessarily belong in a project README.
        </p>

        <div class="mt-5 divide-y divide-line border-t border-line">
          <article class="py-(--gold-space-4)">
            <h3 class="work-title">Technology</h3>

            <p class="work-description mt-1.5 max-w-[62ch]">
              Notes on software development, AI, and the tools and ideas I'm
              exploring. Sometimes technical, sometimes just an observation
              worth writing down.
            </p>
          </article>

          <article class="py-(--gold-space-4)">
            <h3 class="work-title">Life</h3>

            <p class="work-description mt-1.5 max-w-[62ch]">
              Experiences, personal reflections, and questions I've been
              thinking about. Not everything needs to have a technical
              explanation.
            </p>
          </article>

          <article class="py-(--gold-space-4)">
            <h3 class="work-title">Faith</h3>

            <p class="work-description mt-1.5 max-w-[62ch]">
              Writing about Catholic faith, liturgy, and doctrine, along with
              the questions that come with trying to put belief into practice.
            </p>
          </article>
        </div>
      </section>

      <!-- Beyond Building -->
      <section class="section">
        <h2 class="section-title">Outside of work.</h2>

        <div class="body-copy mt-5 space-y-4">
          <p>
            Away from a keyboard, I spend much of my time around music. I'm a
            pianist and organist, and I've been involved in playing music for
            Catholic liturgy for several years.
          </p>

          <p>
            My Catholic faith is also a significant part of my life. It shapes
            some of the things I read, the questions I ask, and occasionally
            what I write about here.
          </p>
        </div>

        <MarginNote
          id="creative-note-4"
          side="left"
          lead="04 / Half a person"
          anchor="prev"
          arrowTop="14px"
        >
          Anyone who reads only the Work pages meets half a person. An organ
          console and a code editor ask for the same patience.
        </MarginNote>
      </section>

      <!-- Language -->
      <aside
        class="section note-aside border-l border-line-strong pl-(--gold-space-4)"
      >
        <p class="work-description">
          <span class="text-ink">About the writing:</span>
          I write in both English and Indonesian, depending on the subject and which
          language lets me express the idea more naturally.
        </p>
      </aside>

      <!-- Connect -->
      <section class="section">
        <h2 class="section-title">Let's connect.</h2>

        <ul class="socials mt-5 flex flex-wrap gap-x-6 gap-y-2">
          {
            SOCIALS.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="quiet-link inline-flex items-center gap-1.5"
                >
                  <Icon name={social.icon} class="h-3.5 w-3.5 shrink-0" />
                  {social.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>

    <Footer />
  </body>
</html>
