---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";

import BaseHead from "@/components/ui/BaseHead.astro";
import BlogCard from "@/components/Blog/BlogCard.astro";
import Footer from "@/components/ui/Footer.astro";
import Header from "@/components/ui/Header.astro";
import ProfileImg from "@/assets/personal/profile.png";
import { SITE_DESCRIPTION, SITE_TITLE, SOCIALS } from "@/consts";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .filter((post) => !post.data.isDraft)
  .slice(0, 3);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <main class="shell">
      <section
        class="grid gap-y-8 py-12 lg:grid-cols-[1fr_160px] lg:items-center lg:gap-x-14 lg:py-16"
      >
        <div class="order-2 lg:order-1">
          <h1 class="display-text max-w-[22ch]">
            Hi, I’m Alva - I build systems, products, and ideas into something
            usable.
          </h1>

          <div class="mt-6 max-w-[60ch] space-y-4 text-secondary">
            <p>
              I believe in the power of creation and the impact we can have
              through our work.
            </p>

            <p>
              This space is where I document what I’m building, what I’m
              learning, and how I think.
            </p>

            <p class="text-[0.9375rem] text-muted">
              I'll be sharing my thoughts, projects, and anything else that I
              find interesting. Stay tuned!
            </p>
          </div>

          <ul class="mt-7 flex flex-wrap gap-x-5 gap-y-2">
            {
              SOCIALS.map((social) => (
                <li>
                  <a
                    href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="quiet-link inline-flex items-center gap-1.5 text-sm"
                  >
                    <Icon name={social.icon} class="h-3.5 w-3.5" />
                    {social.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <Image
          src={ProfileImg}
          width={320}
          class="order-1 size-32 rounded-full object-cover lg:order-2 lg:size-40"
          alt="Portrait of Alva Jufinto"
        />
      </section>

      <section class="border-t border-line py-12 md:py-14">
        <div class="mb-4 flex items-baseline justify-between gap-6">
          <h2 class="section-title">Recent writing</h2>

          <a href="/blog" class="quiet-link text-sm">All writing</a>
        </div>

        <div class="divide-y divide-line">
          {posts.map((post) => <BlogCard post={post} />)}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
