---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";

import BaseHead from "@/components/ui/BaseHead.astro";
import BlogCard from "@/components/Blog/BlogCard.astro";
import ColumnMeasure from "@/components/ui/ColumnMeasure.astro";
import Footer from "@/components/ui/Footer.astro";
import Header from "@/components/ui/Header.astro";
import MarginNote from "@/components/ui/MarginNote.astro";
import ProfileImg from "@/assets/personal/profile.png";
import { SITE_DESCRIPTION, SITE_TITLE, SOCIALS } from "@/consts";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .filter((post) => !post.data.isDraft)
  .slice(0, 3);
---

<!doctype html>
<html lang="en" data-theme="dark" data-proportion="golden">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <main id="main" class="folio">
      <ColumnMeasure />

      <section class="section">
        <Image
          src={ProfileImg}
          width={320}
          class="h-32 w-32 rounded-full object-cover min-[680px]:h-40 min-[680px]:w-40"
          alt="Portrait of Alva Jufinto"
        />

        <MarginNote
          id="creative-note-1"
          side="left"
          lead="01 / The portrait"
          anchor="prev"
          arrowTop="34px"
        >
          A face before the words.
        </MarginNote>

        <h1 class="display-text mt-6">
          Hi, I’m Alva - I build systems, products, and ideas into something
          usable.
        </h1>

        <MarginNote
          id="creative-note-2"
          side="right"
          lead="02 / Three nouns"
          anchor="prev"
          arrowTop="34px"
        >
          Three nouns, no job title.
        </MarginNote>

        <div class="body-copy mt-5 space-y-4">
          <p>
            I believe in the power of creation and the impact we can have
            through our work.
          </p>

          <p>
            This space is where I document what I’m building, what I’m learning,
            and how I think.
          </p>

          <p class="text-muted">
            I'll be sharing my thoughts, projects, and anything else that I find
            interesting. Stay tuned!
          </p>
        </div>

        <MarginNote
          id="creative-note-3"
          side="right"
          lead="03 / Type settings"
          top="196px"
          anchor="#main .body-copy"
        >
          <span data-typefact="type">16px</span> type,
          <span data-typefact="leading">25.9px</span> leading,
          <span data-typefact="column">600px</span> column. My reading
          comfort, live.
        </MarginNote>

        <ul class="socials mt-6 flex flex-wrap gap-x-5 gap-y-2">
          {
            SOCIALS.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="quiet-link inline-flex items-center gap-1.5"
                >
                  <Icon name={social.icon} class="h-3.5 w-3.5 shrink-0" />
                  {social.label}
                </a>
              </li>
            ))
          }
        </ul>

        <MarginNote
          id="creative-note-4"
          side="left"
          lead="04 / No form"
          anchor="prev"
          arrowTop="6px"
        >
          No contact form here. Just pick a link.
        </MarginNote>
      </section>

      <section class="section">
        <div class="section-heading has-subtitle">
          <h2 class="section-title section-heading-copy">Recent writing</h2>

          <a
            href="/blog"
            class="section-aside quiet-link selection-control relative"
          >
            All writing
          </a>
        </div>

        <div class="mt-5 divide-y divide-line border-t border-line">
          {posts.map((post) => <BlogCard post={post} />)}
        </div>

        <MarginNote
          id="creative-note-5"
          side="right"
          lead="05 / Just the newest"
          anchor="prev"
          arrowTop="30px"
        >
          The newest three; the blog has the rest.
        </MarginNote>
      </section>
    </main>

    <Footer />
  </body>
</html>
