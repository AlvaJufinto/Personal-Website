---
import { Image } from "astro:assets";
import FormattedDate from "@/components/ui/FormattedDate.astro";

const { work } = Astro.props;
const tech = work.data.tech ?? [];
const heroImage = work.data.heroImage;
---

<article class="work-item group">
  <a
    href={`/work/${work.id}/`}
    class:list={[
      "grid gap-(--gold-space-3) py-(--gold-space-4) text-inherit no-underline",
      heroImage &&
        "min-[680px]:grid-cols-[150px_minmax(0,1fr)] min-[680px]:items-center min-[680px]:gap-x-(--gold-space-4)",
    ]}
  >
    {
      heroImage && (
        <div class="work-preview aspect-video overflow-hidden border border-line bg-surface">
          <Image
            src={work.data.heroImage}
            alt={work.data.title}
            width={300}
            height={169}
            class="h-full w-full object-cover"
          />
        </div>
      )
    }

    <div class="flex min-w-0 flex-col justify-center gap-(--gold-space-1)">
      <div
        class="flex flex-wrap items-baseline justify-between gap-x-(--gold-space-3)"
      >
        <h3
          class="work-title group-hover:underline group-hover:decoration-line-strong group-hover:underline-offset-4"
        >
          {work.data.title}
        </h3>

        <p class="meta"><FormattedDate date={work.data.pubDate} /></p>
      </div>

      <p class="work-description line-clamp-2 max-w-[62ch]">
        {work.data.description}
      </p>

      {
        tech.length > 0 && (
          <div class="mt-(--gold-space-2) flex flex-wrap gap-(--gold-space-1)">
            {tech.slice(0, 5).map((item: string) => (
              <span class="pill">{item}</span>
            ))}
            {tech.length > 5 && (
              <span class="pill">+{tech.length - 5} more</span>
            )}
          </div>
        )
      }
    </div>
  </a>
</article>
