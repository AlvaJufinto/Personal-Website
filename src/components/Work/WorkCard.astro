---
import { Image } from "astro:assets";
import FormattedDate from "@/components/ui/FormattedDate.astro";

const { work } = Astro.props;
const tech = work.data.tech ?? [];
const heroImage = work.data.heroImage;
---

<article class="group">
  <a
    href={`/work/${work.id}/`}
    class:list={[
      "grid gap-5 py-3.5 sm:gap-6",
      heroImage && "sm:grid-cols-[190px_1fr]",
    ]}
  >
    {
      heroImage && (
        <div class="overflow-hidden rounded-lg border border-line bg-surface">
          <Image
            src={work.data.heroImage}
            alt={work.data.title}
            width={380}
            height={214}
            class="aspect-video h-full w-full object-cover"
          />
        </div>
      )
    }

    <div class="flex flex-col justify-center gap-1.5">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4">
        <h3
          class="font-heading text-base font-medium tracking-[-0.015em] text-ink group-hover:underline group-hover:decoration-line-strong group-hover:underline-offset-4"
        >
          {work.data.title}
        </h3>

        <p class="meta">
          <FormattedDate date={work.data.pubDate} />
        </p>
      </div>

      <p
        class="line-clamp-2 max-w-[62ch] text-sm leading-relaxed text-secondary"
      >
        {work.data.description}
      </p>

      {
        tech.length > 0 && (
          <div class="mt-1.5 flex flex-wrap gap-1.5">
            {tech.slice(0, 5).map((item: string) => (
              <span class="pill">{item}</span>
            ))}
            {tech.length > 5 && (
              <span class="pill">+{tech.length - 5} more</span>
            )}
          </div>
        )
      }
    </div>
  </a>
</article>
