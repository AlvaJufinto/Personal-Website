---
import { SITE_TITLE } from "@/consts";
import HeaderLink from "./HeaderLink.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="border-b border-line">
  <nav
    class="shell flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-5"
  >
    <a
      href="/"
      class="font-heading text-base font-semibold tracking-[-0.02em] text-ink hover:underline hover:decoration-line-strong hover:underline-offset-4"
    >
      {SITE_TITLE}
    </a>

    <div class="flex items-center gap-5">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/work">Work</HeaderLink>
      <HeaderLink href="/blog">Blog</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>

      <ThemeToggle />
    </div>
  </nav>
</header>
