---
import { Icon } from "astro-icon/components";
---

<button
  id="theme-toggle"
  type="button"
  class="theme-toggle shrink-0"
  aria-label="Switch color theme"
>
  <span class="shows-dark" aria-hidden="true">
    <Icon name="mdi:weather-sunny" class="h-4 w-4" />
  </span>
  <span class="shows-light" aria-hidden="true">
    <Icon name="mdi:weather-night" class="h-4 w-4" />
  </span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    min-height: 32px;
    padding: 4px;
    color: var(--muted);
    background: none;
    border: 1px solid transparent;
    border-radius: 6px;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--line);
  }

  :global(html[data-theme="light"]) .shows-dark {
    display: none;
  }

  :global(html[data-theme="dark"]) .shows-light {
    display: none;
  }
</style>

<script>
  const toggle = document.getElementById("theme-toggle");

  toggle?.addEventListener("click", () => {
    const next =
      document.documentElement.dataset.theme === "light" ? "dark" : "light";

    document.documentElement.dataset.theme = next;

    try {
      localStorage.setItem("theme", next);
    } catch {
      // Storage unavailable (private mode): the theme still switches for this page.
    }
  });
</script>
