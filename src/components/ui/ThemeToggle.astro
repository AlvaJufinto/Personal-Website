---
import { Icon } from "astro-icon/components";
---

<button
  id="theme-toggle"
  type="button"
  class="theme-toggle selection-control relative inline-flex min-h-11 min-w-11 shrink-0 cursor-pointer items-center justify-center rounded-(--gold-radius-control) border border-transparent bg-transparent p-1 text-muted transition-colors ease-[ease] hover:border-line hover:text-ink"
  aria-label="Switch color theme"
>
  <span class="shows-dark" aria-hidden="true">
    <Icon name="mdi:weather-sunny" class="h-4 w-4" />
  </span>
  <span class="shows-light" aria-hidden="true">
    <Icon name="mdi:weather-night" class="h-4 w-4" />
  </span>
</button>

<style>
  :global(html[data-theme="light"]) .shows-dark {
    display: none;
  }

  :global(html[data-theme="dark"]) .shows-light {
    display: none;
  }
</style>

<script>
  const toggle = document.getElementById("theme-toggle");

  toggle?.addEventListener("click", () => {
    const next =
      document.documentElement.dataset.theme === "light" ? "dark" : "light";

    document.documentElement.dataset.theme = next;

    try {
      localStorage.setItem("theme", next);
    } catch {
      // Storage unavailable (private mode): the theme still switches for this page.
    }
  });
</script>
