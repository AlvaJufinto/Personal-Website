---
interface Props {
  link: string;
}

const { link } = Astro.props;
---

<div
  class="relative mt-[1.6em] mb-[0.9em] aspect-video w-full overflow-hidden rounded-lg border border-line"
>
  <iframe
    loading="lazy"
    class="absolute inset-0 m-0 h-full w-full border-0 p-0"
    src={link}
    allowfullscreen="allowfullscreen"
    allow="fullscreen"
  >
  </iframe>
</div>
