---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<aside class="my-7 border-l border-line-strong bg-surface py-4 pl-5 pr-4">
  <p class="mb-0 font-heading text-sm font-medium text-ink">{title}</p>

  <div class="mt-1.5 text-[0.75rem] leading-[1.7] text-secondary [&_p]:mb-0">
    <slot />
  </div>
</aside>
