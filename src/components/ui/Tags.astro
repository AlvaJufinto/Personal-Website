---
interface Props {
  topics?: string[];
  tech?: string[];
  category?: string[];
  language?: string;
}

const { topics, tech, category, language } = Astro.props;

const items = [
  ...new Set([...(topics ?? []), ...(tech ?? []), ...(category ?? [])]),
];
---

{
  (items.length > 0 || language) && (
    <div class="mt-4 flex flex-wrap items-center gap-1.5">
      {items.map((item) => (
        <span class="pill">{item}</span>
      ))}

      {language && (
        <span
          class="pill"
          title={
            language === "id" ? "Written in Indonesian" : "Written in English"
          }
        >
          {language.toUpperCase()}
        </span>
      )}
    </div>
  )
}
