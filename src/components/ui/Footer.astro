---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import HumanBadge from "@/assets/icons/human-badge.png";
import { SOCIALS } from "@/consts";

const today = new Date();
---

<footer class="mt-24 border-t border-line py-12">
  <div
    class="shell flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between"
  >
    <div class="max-w-md">
      <p class="label">Portfolio</p>

      <p class="mt-2 font-heading text-lg font-semibold text-ink">
        Stanislaus Alva Jufinto.
      </p>

      <p class="mt-3 text-sm leading-relaxed text-secondary">
        Engineer by trade. Indie builder by nature.
      </p>

      <p class="meta mt-5">© {today.getFullYear()} · All rights reserved</p>
    </div>

    <div class="flex flex-col items-start gap-5 lg:items-end">
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {
          SOCIALS.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="quiet-link inline-flex items-center gap-1.5 text-sm"
              >
                <Icon name={social.icon} class="h-3.5 w-3.5" />
                {social.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href="https://notbyai.fyi/"
        target="_blank"
        rel="noopener noreferrer"
        class="opacity-70 transition-opacity hover:opacity-100"
        aria-label="Human Made Badge"
      >
        <Image height={28} src={HumanBadge} alt="" width={84} />
      </a>
    </div>
  </div>
</footer>
