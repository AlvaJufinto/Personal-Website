---
import { Icon } from "astro-icon/components";
import { STUDIO_GROUPS, STUDIO_PRESETS } from "@/lib/studio";

/* Panel organisation: presets first, then the existing groups under loose
 * section headings, then the inspector. Ordering lives here — STUDIO_GROUPS
 * stays the single source of truth for the settings themselves. */
const panelSections: { label: string; keys: string[] }[] = [
  { label: "Typography", keys: ["face", "leading"] },
  { label: "Layout", keys: ["column", "rhythm"] },
  { label: "Motion", keys: ["motion"] },
];

const inspectorOptions: { key: string; label: string }[] = [
  { key: "outlines", label: "Outlines" },
  { key: "dimensions", label: "Dimensions" },
  { key: "spacing", label: "Spacing" },
  { key: "ruler", label: "Ruler" },
  { key: "columns", label: "Column guides" },
  { key: "baseline", label: "Line grid" },
];
---

<!-- Creative mode's styling surface. The trigger only exists inside the
     annotation layer, so it is revealed by the same .notes-open state the
     notes use rather than by markup the page has to remember. -->
<button
  id="studio-toggle"
  type="button"
  class="studio-toggle selection-control"
  aria-label="Typeset styling"
  aria-expanded="false"
  aria-controls="studio-panel"
>
  <Icon name="mdi:format-size" class="h-5 w-5" />
  <span class="studio-tooltip" aria-hidden="true"
    >Type, column &amp; rhythm</span
  >
</button>

<div
  id="studio-panel"
  class="studio-panel"
  role="dialog"
  aria-labelledby="studio-title"
  hidden
>
  <!-- The head is the grab surface: it is the one region of the panel with
       nothing to click, so a pointer down here can never be mistaken for a
       choice. Keyboard moves are the same element, focused rather than held. -->
  <header
    class="studio-head"
    data-studio-handle
    tabindex="0"
    aria-label="Move panel"
    title="Drag to move · arrow keys to nudge · Home and End dock to an edge"
  >
    <h2 id="studio-title" class="studio-title">Typeset</h2>
    <p class="studio-sub">Applies as you choose, remembered on this device.</p>
  </header>

  <div class="studio-fields">
    <div class="studio-block">
      <p class="studio-legend">
        <span class="studio-legend-label">Presets</span>
        <span class="studio-live" id="studio-preset-state">—</span>
      </p>

      <div class="studio-presets" role="radiogroup" aria-label="Presets">
        {
          STUDIO_PRESETS.map((preset) => (
            <label class="studio-preset" data-preset={preset.id}>
              <input
                class="studio-input"
                type="radio"
                name="studio-preset"
                value={preset.id}
              />
              <span
                class="studio-preset-preview"
                aria-hidden="true"
                data-face={preset.settings.face}
                data-column={preset.settings.column}
                data-leading={preset.settings.leading}
                data-rhythm={preset.settings.rhythm}
              >
                <span class="preset-heading">Ag</span>
                <span class="preset-line" />
                <span class="preset-line" />
                <span class="preset-gap" aria-hidden="true" />
                <span class="preset-line" />
                <span class="preset-line preset-line-short" />
              </span>
              <span class="studio-preset-label">{preset.label}</span>
              <span class="studio-preset-desc">{preset.description}</span>
            </label>
          ))
        }
      </div>
    </div>

    {
      panelSections.map((section) => (
        <div class="studio-block">
          <p class="studio-block-title">{section.label}</p>

          {section.keys.map((key) => {
            const group = STUDIO_GROUPS.find((g) => g.key === key)!;

            return (
              <div
                class="studio-field"
                role="radiogroup"
                aria-labelledby={`studio-legend-${group.key}`}
              >
                <p class="studio-legend" id={`studio-legend-${group.key}`}>
                  <span class="studio-legend-label">{group.label}</span>
                  {/* No measured value for the face: a computed font-family
                      reports the declared stack, not what actually rendered.
                      The panel title is set in that face, so it is its own
                      readout. */}
                  {group.key !== "face" && (
                    <span class="studio-live" data-studio-live={group.key}>
                      —
                    </span>
                  )}
                </p>

                <div class="studio-options">
                  {group.options.map((option, index) => {
                    // Three-option rows leave a half-empty grid; the last
                    // choice takes the full width so the hairlines stay
                    // continuous.
                    const isWideLast =
                      index === group.options.length - 1 &&
                      group.options.length % 2 === 1;

                    return (
                      <label
                        class:list={[
                          "studio-option",
                          { "studio-option-wide": isWideLast },
                        ]}
                      >
                        <input
                          class="studio-input"
                          type="radio"
                          name={`studio-${group.key}`}
                          value={option.value}
                        />
                        <span class="studio-option-label">{option.label}</span>
                        <span class="studio-option-readout">
                          {option.readout}
                        </span>
                      </label>
                    );
                  })}
                </div>
              </div>
            );
          })}
        </div>
      ))
    }

    <div class="studio-block">
      <p class="studio-legend">
        <span class="studio-legend-label">Inspector</span>
        <span class="studio-live" id="studio-inspector-state">Off</span>
      </p>

      <p class="studio-inspector-copy">
        Measure the page itself: click a section to read its layout below.
      </p>

      <label class="studio-toggle-row">
        <span class="studio-toggle-row-label">Inspector</span>
        <input
          class="studio-switch-input"
          type="checkbox"
          id="inspector-master"
        />
        <span class="studio-switch" aria-hidden="true"><span></span></span>
      </label>

      <div class="studio-inspector-options">
        {
          inspectorOptions.map((option) => (
            <label class="studio-toggle-row">
              <span class="studio-toggle-row-label">{option.label}</span>
              <input
                class="studio-switch-input"
                type="checkbox"
                data-inspector={option.key}
              />
              <span class="studio-switch" aria-hidden="true">
                <span />
              </span>
            </label>
          ))
        }
      </div>

      <div class="studio-inspector-info" id="studio-inspector-info" hidden>
      </div>
    </div>
  </div>

  <footer class="studio-foot">
    <button
      type="button"
      id="studio-reset"
      class="studio-action selection-control"
    >
      Reset
    </button>
    <button
      type="button"
      id="studio-close"
      class="studio-action selection-control"
    >
      Close
    </button>
  </footer>
</div>

<!-- One off-screen element whose computed styles are the live values of every
     token the studio drives. The panel readouts and the margin-note numbers
     both come from here, so neither can quote a value the page does not use. -->
<span class="studio-probe" aria-hidden="true"></span>

<script>
  import {
    STUDIO_DEFAULTS,
    STUDIO_GROUPS,
    STUDIO_PRESETS,
    applySettings,
    clearSettings,
    isStudioKey,
    matchPreset,
    readSettings,
    readStudioUIState,
    writeSettings,
    writeStudioUIState,
  } from "@/lib/studio";
  import { mountInspector, type OverlayName } from "@/lib/inspector";
  import { mountStudioDrag, SHEET_LAYOUT } from "@/lib/studio-drag";

  const toggle = document.getElementById("studio-toggle");
  const panel = document.getElementById("studio-panel");
  const probe = document.querySelector<HTMLElement>(".studio-probe");

  if (toggle && panel && probe) mount(toggle, panel, probe);

  /** `25.9` not `25.900000000000001`, and no trailing `.0` on whole numbers. */
  function num(value: number, digits: number) {
    return String(Number(value.toFixed(digits)));
  }

  function mount(toggle: HTMLElement, panel: HTMLElement, probe: HTMLElement) {
    let settings = readSettings();

    /* The DOM is the source of truth — the open flag and every checkbox. */
    function persistUI() {
      const master = panel.querySelector<HTMLInputElement>("#inspector-master");
      const overlays: Record<string, boolean> = {};
      for (const input of panel.querySelectorAll<HTMLInputElement>(
        "[data-inspector]",
      )) {
        const name = input.dataset.inspector;
        if (name) overlays[name] = input.checked;
      }
      writeStudioUIState({
        open: !panel.hidden,
        inspecting: !!master?.checked,
        overlays,
      });
    }

    interface Facts {
      type: number;
      leading: number;
      ratio: string;
      column: number;
      rhythm: number;
      motion: string;
    }

    /* The probe carries the live token values, so every number in this file —
     * panel readouts and margin-note copy alike — is measured, never restated. */
    function facts(): Facts {
      const cs = getComputedStyle(probe);
      const type = Number.parseFloat(cs.fontSize) || 16;
      const rawLeading = cs.lineHeight;
      const leading = rawLeading.endsWith("px")
        ? Number.parseFloat(rawLeading)
        : Number.parseFloat(rawLeading) * type;

      return {
        type,
        leading,
        ratio:
          cs.getPropertyValue("--body-leading").trim() ||
          num(leading / type, 3),
        column: Number.parseFloat(cs.width),
        rhythm: Number.parseFloat(cs.marginTop),
        motion:
          settings.motion === "off" ||
          matchMedia("(prefers-reduced-motion: reduce)").matches
            ? "reduced"
            : "system default",
      };
    }

    function setLive(key: string, value: string) {
      const el = panel.querySelector<HTMLElement>(
        `[data-studio-live="${key}"]`,
      );
      if (el) el.textContent = value;
    }

    /** Keep the annotation layer honest about the styling it is describing. */
    function syncNotes(f: Facts) {
      for (const rules of document.querySelectorAll<HTMLElement>(
        "#main .column-measure",
      )) {
        /* Read #main, not the rules: once they are hidden their own box
         * collapses to zero, and a zero would keep them hidden forever. */
        const rendered: any =
          rules?.parentElement?.getBoundingClientRect().width;
        // The rules measure the design column. A viewport too narrow for it is
        // measuring the window, so the annotation has nothing to say: hide it
        // rather than print a width the page never chose.
        rules.hidden = Math.abs(rendered - f.column) > 0.5;

        const label = rules.querySelector<HTMLElement>("[data-measure-label]");
        if (label) label.textContent = `${num(rendered, 0)} px`;
      }

      for (const fact of document.querySelectorAll<HTMLElement>(
        "[data-typefact]",
      )) {
        const key = fact.dataset.typefact;
        if (key === "type") fact.textContent = `${Math.round(f.type)}px`;
        if (key === "leading") fact.textContent = `${num(f.leading, 1)}px`;
        if (key === "column") fact.textContent = `${num(f.column, 0)}px`;
      }

      /* A note pinned to a fixed offset stops pointing at its subject the moment
       * the type reflows, so anchored notes track their target. */
      for (const note of document.querySelectorAll<HTMLElement>(
        "#main .margin-note[data-anchor]",
      )) {
        const key = note.dataset.anchor ?? "";

        /* "prev" / "next" name the neighbouring block instead of a selector, so
         * a note written inside a rendered article can point at the heading it
         * follows without depending on an id that markdown never emits. */
        const target =
          key === "prev"
            ? note.previousElementSibling
            : key === "next"
              ? note.nextElementSibling
              : document.querySelector(key);

        /* The containing block, not the parent: in a long-form body the note
         * sits inside unpositioned wrappers, so the offset belongs to #main. */
        const host =
          (note.offsetParent as HTMLElement | null) ?? note.parentElement;
        if (!target || !host) continue;

        const top =
          target.getBoundingClientRect().top - host.getBoundingClientRect().top;
        note.style.setProperty("--note-top", `${Math.round(top)}px`);
      }

      syncClearance();
    }

    /* The panel is a tool laid over the sheet, so a note it would cut mid-word
     * steps aside rather than being sliced. Which notes do that is measured, not
     * assumed: a wide window leaves every one of them in place. Only the margin
     * layout needs it — narrower than 1200px the notes flow under their subject
     * and an overlapping panel is simply how popovers behave. */
    function syncClearance() {
      const inMargin = matchMedia("(min-width: 1200px)").matches;
      const box =
        panel.hidden || !inMargin ? null : panel.getBoundingClientRect();

      for (const note of document.querySelectorAll<HTMLElement>(
        "#main .margin-note",
      )) {
        if (!box) {
          note.classList.remove("note-clear");
          continue;
        }

        const r = note.getBoundingClientRect();
        note.classList.toggle(
          "note-clear",
          r.left < box.right &&
            box.left < r.right &&
            r.top < box.bottom &&
            box.top < r.bottom,
        );
      }
    }

    /* The inspector is a sibling concern, not a second settings system: it
     * reads the same probe facts() measures and never writes a token. */
    const inspector = mountInspector({
      getFacts: facts,
      infoPanel: document.getElementById("studio-inspector-info"),
    });

    function setInspecting(on: boolean) {
      const master = panel.querySelector<HTMLInputElement>("#inspector-master");
      if (master) master.checked = on;
      inspector.setActive(on);
      const state = document.getElementById("studio-inspector-state");
      if (state) state.textContent = on ? "On" : "Off";
      for (const input of panel.querySelectorAll<HTMLInputElement>(
        "[data-inspector]",
      )) {
        input.disabled = !on;
      }
      persistUI();
    }

    /* A hand-tuned configuration that no longer matches a preset reads as its
     * own state ("Custom") rather than keeping the last preset lit. */
    function syncPresetState() {
      const preset = matchPreset(settings);
      const state = document.getElementById("studio-preset-state");
      if (state) state.textContent = preset ? preset.label : "Custom";
      for (const input of panel.querySelectorAll<HTMLInputElement>(
        'input[name="studio-preset"]',
      )) {
        input.checked = input.value === preset?.id;
      }
    }

    function render() {
      applySettings(settings);

      for (const group of STUDIO_GROUPS) {
        for (const input of panel.querySelectorAll<HTMLInputElement>(
          `input[name="studio-${group.key}"]`,
        )) {
          input.checked = input.value === settings[group.key];
        }
      }

      const f = facts();
      setLive("column", `${num(f.column, 0)} px`);
      setLive("leading", `${num(f.leading, 1)} px · ${f.ratio}`);
      setLive("rhythm", `${num(f.rhythm, 1)} px`);
      setLive("motion", f.motion);
      syncNotes(f);
      syncPresetState();
      // Overlays quote the same token values, so a settings change has to
      // re-measure them too — column guides and the line grid both depend on it.
      inspector.refresh();
    }

    function setOpen(open: boolean) {
      panel.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));

      if (open && !matchMedia(SHEET_LAYOUT).matches) {
        requestAnimationFrame(() => {
          panel
            .querySelector<HTMLElement>("[data-studio-handle]")
            ?.focus({ preventScroll: true });
        });
      }

      syncClearance();
    }
    toggle.addEventListener("click", () => setOpen(panel?.hidden as boolean));

    panel
      .querySelector<HTMLElement>("#studio-close")
      ?.addEventListener("click", () => {
        setOpen(false);
        toggle.focus();
      });

    panel
      .querySelector<HTMLElement>("#studio-reset")
      ?.addEventListener("click", () => {
        clearSettings();
        settings = { ...STUDIO_DEFAULTS };
        render();
      });

    panel.addEventListener("change", (event) => {
      const input = event.target as HTMLInputElement;

      if (input.id === "inspector-master") {
        setInspecting(input.checked);
        return;
      }

      const overlay = input.dataset.inspector;
      if (overlay) {
        inspector.setOverlay(overlay as OverlayName, input.checked);
        persistUI();
        return;
      }

      if (input.type !== "radio") return;

      if (input.name === "studio-preset") {
        const preset = STUDIO_PRESETS.find((p) => p.id === input.value);
        if (!preset) return;
        settings = { ...preset.settings };
        writeSettings(settings);
        render();
        return;
      }

      const key = input.name.replace("studio-", "");
      if (!isStudioKey(key)) return;

      settings = { ...settings, [key]: input.value };
      writeSettings(settings);
      render();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || panel.hidden) return;
      setOpen(false);
      toggle.focus();
    });

    // The trigger only exists in Creative mode, so leaving the mode has to take
    // the panel with it rather than strand a dialog with no owner.
    document.addEventListener("creative-mode", (event) => {
      const detail = (event as CustomEvent<{ open: boolean }>).detail;
      if (detail && !detail.open) setOpen(false);
    });

    /* Bound before the reflow listener below: the panel is back inside the
     * viewport before the annotations decide what it overlaps. */
    mountStudioDrag(panel, syncClearance);

    /* Re-measure on reflow: the rendered column width the label prints and the
     * anchored note offsets both depend on it. Directly, not in a animation
     * frame — a backgrounded tab throttles those, and a stale number in an
     * annotation is worse than one extra layout pass. */
    addEventListener("resize", render);

    /* Restore how the tool was left this visit. Settings come back via
     * localStorage pre-paint; this only restores the panel + inspector UI. The
     * panel only auto-opens when Creative mode is on — without it the trigger is
     * hidden and a floating panel would have no owner. */
    const ui = readStudioUIState();
    const open =
      ui?.open === true &&
      document.documentElement.classList.contains("notes-open");
    const inspecting = open === true && ui?.inspecting === true;

    if (ui?.overlays) {
      for (const input of panel.querySelectorAll<HTMLInputElement>(
        "[data-inspector]",
      )) {
        const name = input.dataset.inspector;
        if (name && typeof ui.overlays[name] === "boolean") {
          input.checked = ui.overlays[name];
        }
      }
    }

    setOpen(open);
    setInspecting(inspecting);

    // Seed the inspector's own overlay map from the restored checkboxes. Safe
    // while inactive too: setOverlay only records the choice until refresh.
    for (const input of panel.querySelectorAll<HTMLInputElement>(
      "[data-inspector]",
    )) {
      const name = input.dataset.inspector;
      if (name) inspector.setOverlay(name as OverlayName, input.checked);
    }

    render();
  }
</script>
