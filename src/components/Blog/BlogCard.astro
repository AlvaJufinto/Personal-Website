---
import FormattedDate from "@/components/ui/FormattedDate.astro";

const { post } = Astro.props;
const topics = post.data.topics ?? [];
const language = post.data.language;
---

<article class="group">
  <a
    href={`/blog/${post.id}/`}
    class="grid gap-x-6 gap-y-1.5 py-3.5 md:grid-cols-[110px_1fr] md:items-baseline"
  >
    <p class="meta pt-0.5">
      <FormattedDate date={post.data.pubDate} />
    </p>

    <div>
      <h3
        class="font-heading text-base font-medium leading-snug tracking-[-0.015em] text-ink group-hover:underline group-hover:decoration-line-strong group-hover:underline-offset-4"
      >
        {post.data.title}
      </h3>

      {
        post.data.description && (
          <p class="mt-1.5 line-clamp-2 max-w-[62ch] text-sm leading-relaxed text-secondary">
            {post.data.description}
          </p>
        )
      }

      {
        (topics.length > 0 || language) && (
          <p class="meta mt-2 flex flex-wrap items-center gap-x-2.5 gap-y-1">
            {topics.map((topic: string) => (
              <span>{topic}</span>
            ))}

            {language && (
              <>
                {topics.length > 0 && <span aria-hidden="true">·</span>}
                <span>{language.toUpperCase()}</span>
              </>
            )}
          </p>
        )
      }
    </div>
  </a>
</article>
