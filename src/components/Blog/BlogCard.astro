---
import FormattedDate from "@/components/ui/FormattedDate.astro";

const { post } = Astro.props;
const topics = post.data.topics ?? [];
const language = post.data.language;
---

<article class="writing-item group">
  <a
    href={`/blog/${post.id}/`}
    class="grid gap-(--gold-space-1) py-(--gold-space-4) text-inherit no-underline min-[680px]:grid-cols-[110px_minmax(0,1fr)] min-[680px]:items-baseline min-[680px]:gap-x-(--gold-space-4)"
  >
    <p class="meta min-[680px]:pt-0.5">
      <FormattedDate date={post.data.pubDate} />
    </p>

    <div class="min-w-0">
      <h3
        class="work-title group-hover:underline group-hover:decoration-line-strong group-hover:underline-offset-4"
      >
        {post.data.title}
      </h3>

      {
        post.data.description && (
          <p class="work-description line-clamp-2 mt-1.5">
            {post.data.description}
          </p>
        )
      }

      {
        (topics.length > 0 || language) && (
          <p class="meta mt-2 flex flex-wrap items-center gap-x-2.5 gap-y-1">
            {topics.map((topic: string) => (
              <span>{topic}</span>
            ))}

            {language && (
              <>
                {topics.length > 0 && <span aria-hidden="true">·</span>}
                <span>{language.toUpperCase()}</span>
              </>
            )}
          </p>
        )
      }
    </div>
  </a>
</article>
